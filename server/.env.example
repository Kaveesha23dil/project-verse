# Copy this file to .env and fill in your MySQL credentials.
# The API reads this through dotenv — see src/db.js.

DB_HOST=127.0.0.1
DB_PORT=3300
DB_USER=root
DB_PASSWORD=
DB_NAME=projectverse

# Set to true when your host requires TLS (Railway, Aiven, PlanetScale...).
DB_SSL=false

# Signs the access tokens handed out at login and registration.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Origin allowed by CORS. Must match the address you open the site on.
CLIENT_URL=http://127.0.0.1:5173

PORT=4000

# Admin AI Review. The key stays on the server; never use a VITE_ variable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
